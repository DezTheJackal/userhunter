    <g stroke="#20241f" stroke-width="2" opacity="0.4" stroke-linecap="round">
      <line x1="-30" y1="-80" x2="-14" y2="-68"/>
      <line x1="40" y1="-30" x2="55" y2="-20"/>
      <line x1="10" y1="60" x2="22" y2="72"/>
